# ─────────────────────────────────────────────────────────────
# CareerOS AI Service — Environment Variables
# Copy this file to .env and fill in the values you need.
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
PORT=8000
BACKEND_SERVICE_URL=http://localhost:4000

# ── LLM Provider ─────────────────────────────────────────────
# Options: "mock" (default, no API key needed) | "openai" | "gemini"
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Vector Store ─────────────────────────────────────────────
# Options: "mock" (default, no setup needed) | "chroma" | "pinecone"
VECTOR_STORE=mock

# Required when VECTOR_STORE=chroma
# pip install chromadb
CHROMA_PERSIST_DIR=./.chroma

# Required when VECTOR_STORE=pinecone
# pip install pinecone-client
PINECONE_API_KEY=
PINECONE_INDEX=careeros-career-memory

# ── Embedding (Pinecone only) ────────────────────────────────
# Pinecone doesn't embed text — we use OpenAI's embedding API.
# OPENAI_API_KEY above must also be set when using Pinecone.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
