ENVIRONMENT=development
PORT=8000

# "openai" | "gemini" | "mock" — mock needs no key and is the default,
# so the service runs out of the box for local development.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# "chroma" | "pinecone" | "mock"
VECTOR_STORE=mock
CHROMA_PERSIST_DIR=./.chroma
PINECONE_API_KEY=
PINECONE_INDEX=careeros-career-memory

BACKEND_SERVICE_URL=http://localhost:4000
