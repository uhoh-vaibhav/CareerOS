generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECRUITER
  PLACEMENT_OFFICER
  FACULTY
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
}

enum JobStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  profile      StudentProfile?
  jobPostings  JobPosting[]

  @@map("users")
}

model StudentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  education  String?
  targetRole String?
  skills     Json?

  resumes         Resume[]
  skillGapReports SkillGapReport[]
  mentorSessions  MentorSession[]
  mockInterviews  MockInterview[]
  portfolio       GitHubPortfolio?
  certificates    Certificate[]
  readinessScores ReadinessScore[]
  applications    Application[]

  @@map("student_profiles")
}

model Resume {
  id         String         @id @default(uuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fileUrl    String
  parsedJson Json?
  atsScore   Int?
  createdAt  DateTime       @default(now())

  @@map("resumes")
}

model SkillGapReport {
  id            String         @id @default(uuid())
  profileId     String
  profile       StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  targetRole    String
  missingSkills Json?
  createdAt     DateTime       @default(now())

  roadmap       LearningRoadmap?

  @@map("skill_gap_reports")
}

model LearningRoadmap {
  id           String         @id @default(uuid())
  reportId     String         @unique
  report       SkillGapReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  milestones   Json?
  progressPct  Int            @default(0)

  @@map("learning_roadmaps")
}

model MentorSession {
  id          String         @id @default(uuid())
  profileId   String
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  summary     String?
  vectorRefId String?
  createdAt   DateTime       @default(now())

  @@map("mentor_sessions")
}

model MockInterview {
  id        String         @id @default(uuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  role      String
  feedback  Json?
  score     Int?
  createdAt DateTime       @default(now())

  @@map("mock_interviews")
}

model GitHubPortfolio {
  id             String         @id @default(uuid())
  profileId      String         @unique
  profile        StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  githubUsername String
  analysisJson   Json?
  updatedAt      DateTime       @updatedAt

  @@map("github_portfolios")
}

model Certificate {
  id        String         @id @default(uuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title     String
  issuer    String?
  fileUrl   String?
  createdAt DateTime       @default(now())

  @@map("certificates")
}

model ReadinessScore {
  id              String         @id @default(uuid())
  profileId       String
  profile         StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  compositeScore  Int
  breakdown       Json
  computedAt      DateTime       @default(now())

  @@map("readiness_scores")
}

model JobPosting {
  id               String        @id @default(uuid())
  recruiterUserId  String
  recruiter        User          @relation(fields: [recruiterUserId], references: [id], onDelete: Cascade)

  title            String
  requiredSkills   Json?
  status           JobStatus     @default(OPEN)
  createdAt        DateTime      @default(now())

  applications     Application[]

  @@map("job_postings")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId   String
  profile     StudentProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  aiRankScore Int?
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())

  @@map("applications")
}
