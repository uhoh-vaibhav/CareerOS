NODE_ENV=development
PORT=4000

# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros

# Change this in any real deployment
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Internal URL of the Python/FastAPI AI microservice
AI_SERVICE_URL=http://localhost:8000
